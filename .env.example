# pdf-mcp configuration
# Copy to .env and fill in your values

# Server mode: "stdio" (default) or "http"
MCP_MODE=http

# HTTP server settings (used when MCP_MODE=http)
MCP_HOST=127.0.0.1
MCP_PORT=11131

# Frontend dev server (for CORS)
FRONTEND_PORT=11130

# RAG settings
# Leave EMPTY to use LanceDB built-in embeddings (all-MiniLM-L6-v2 via sentence-transformers)
# Or set an OpenAI-compatible endpoint for better embeddings:
# RAG_EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
# RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_URL=
RAG_EMBEDDING_MODEL=

# LanceDB storage path (default: data/lancedb)
RAG_STORE_PATH=data/lancedb

# Upload directory
UPLOAD_DIR=data/uploads

# Tauri flag (set to 1 when running inside Tauri WebView)
PDF_MCP_TAURI=
